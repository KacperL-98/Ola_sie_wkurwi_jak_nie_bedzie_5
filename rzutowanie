def Vgrid_from_radial(Vr):
    return np.interp(R, r, Vr)

# ==========================================================
# NARZĘDZIA NUMERYCZNE
# ==========================================================

def integrate2d(f):
    tmp = simpson(f, theta, axis=1)
    return simpson(tmp, r)

def normalize(psi):

    rho = np.abs(psi)**2 * R

    I_theta = simpson(
        rho,
        theta,
        axis=1
    )

    I = simpson(
        I_theta,
        r
    )

    return psi/np.sqrt(I)


# ==========================================================
# LAPLACIAN
# ==========================================================

def laplacian(psi):

    dpsi_dr = np.zeros_like(psi)
    dpsi_dr[1:-1] = (psi[2:] - psi[:-2]) / (2*dr)

    term_r = np.zeros_like(psi)
    term_r[1:-1] = ((R[2:] * dpsi_dr[2:] -
                     R[:-2] * dpsi_dr[:-2]) / (2*dr)) / R[1:-1]

    term_theta = np.zeros_like(psi)
    term_theta[:,1:-1] = (
        psi[:,2:] - 2*psi[:,1:-1] + psi[:,:-2]
    ) / dtheta**2

    lap = term_r + term_theta/R**2

    return lap
# ==========================================================
# FUNKCJE PRÓBNE
# ==========================================================


def psi_1s(b):

    return normalize(
        np.exp(-R/b)
    )

def psi_2s(b2,b1):

    d = (b1+b2)/(2*b1)

    return normalize(
        (1-d*R/b2)
        *
        np.exp(-R/b2)
    )

def psi_2px(b):

    return normalize(
        R*np.cos(Theta)
        *
        np.exp(-R/b)
    )

def psi_2py(b):

    return normalize(
        R*np.sin(Theta)
        *
        np.exp(-R/b)
    )

# ==========================================================
# SOLVER WARIACYJNY
# ==========================================================

class ExcitonSolver:

    def __init__(self, mu_eff, Vr):
        self.mu = mu_eff
        self.Vgrid = Vgrid_from_radial(Vr)

    def energy(self, psi):
        lap = laplacian(psi)
        Hpsi = -(1/(2*self.mu))*lap + self.Vgrid*psi

        num = integrate2d(np.conjugate(psi)*Hpsi*R)
        den = integrate2d(np.conjugate(psi)*psi*R)

        return (num/den).real

    def solve(self):

        res1 = minimize_scalar(lambda b: self.energy(psi_1s(b)),
                                bounds=(0.1,300), method="bounded")

        res2 = minimize_scalar(lambda b: self.energy(psi_2px(b)),
                                bounds=(0.1,300), method="bounded")

        return {
            "E1s": res1.fun * HA_TO_EV,
            "E2p": res2.fun * HA_TO_EV,
            "b1": res1.x
        }

# POSCAR wczytywanie

def poscal_read(filename):

    with open(filename, "r") as f:
        lines = [l.strip() for l in f.readlines() if l.strip()]

    scale = float(lines[1])

    lattice = np.array([list(map(float, lines[2].split())),list(map(float, lines[3].split())),list(map(float, lines[4].split()))]) * scale

    jed = lines[5].split()
    counts = list(map(int, lines[6].split()))

    wsp = np.array([list(map(float, lines[8+i].split()[:3]))for i in range(sum(counts))])

    if "direct" in lines[7].lower():
        wsp = wsp @ lattice

    atom_types = []
    for sp, c in zip(jed, counts):
        atom_types += [sp]*c

    return atom_types, wsp

#projetkowanie
r_grid = r

def proj_str(poscar_file, psi):

    atom_types, wsp = poscal_read(poscar_file)

    density_r = simpson(np.abs(psi)**2, theta, axis=1)

    results = []

    for t,(x,y,z) in zip(atom_types, wsp):

        r_atom = np.sqrt(x**2 + y**2)
        val = np.interp(r_atom, r_grid, density_r)

        results.append((t,x,y,z,val))

    return results


def proj_save(data, filename):

    with open(filename,"w") as f:
        for t,x,y,z,v in data:
            f.write(f"{t} {x:.6f} {y:.6f} {z:.6e} {v:.8e}\n")

