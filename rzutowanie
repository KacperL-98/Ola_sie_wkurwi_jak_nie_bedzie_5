# ==========================================================
# MODEL εeff(q)
# ==========================================================

def gamma_plus(q):
    return ((1 + np.exp(-2*d_wse2_ang*q)) * eps_wse2 +
            (1 - np.exp(-2*d_wse2_ang*q)) * eps_hbn)

def gamma_minus(q):
    return ((1 - np.exp(-2*d_wse2_ang*q)) * eps_wse2 +
            (1 + np.exp(-2*d_wse2_ang*q)) * eps_hbn)

def A_q(q):
    gp = gamma_plus(q)
    gm = gamma_minus(q)

    return ((1 - np.exp(-2*d_ws2_ang*q)) *
            (eps_ws2**2 * gp + eps_hbn * eps_wse2 * gm) +
            (1 + np.exp(-2*d_ws2_ang*q)) *
            (eps_hbn * eps_ws2 * gp + eps_ws2 * eps_wse2 * gm))

def B_q(q):
    t1 = ((1 - np.exp(-d_ws2_ang*q)) * eps_hbn +
          (1 + np.exp(-d_ws2_ang*q)) * eps_ws2)

    t2 = ((1 + np.exp(-d_wse2_ang*q)) * eps_wse2 +
          (1 - np.exp(-d_wse2_ang*q)) * eps_hbn)

    return 2 * t1 * t2

def eps_eff(q):
    return A_q(q) / B_q(q)

