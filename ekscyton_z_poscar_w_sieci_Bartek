def project_exciton_to_atoms(psi1s):

    density_r = simpson(
        np.abs(psi1s)**2,
        theta,
        axis=1
    )
    # inkorporacja wielkosci do struktury z POSCAR
    #gestozc prawdopodobienstwa dla kazdego atomu
    atom_density = []

    for x, y, z in coords:

        rr = np.sqrt(
            (x - x0)**2 +
            (y - y0)**2
        )

        rho = np.interp(
            rr,
            r,
            density_r,
            left=0,
            right=0
        )
        #zapisanie wartosci dla atomu i zlozenie tablicy wynikow
        atom_density.append(rho)

    return np.array(atom_density)


# osobno dla dowolnego stanu, nie tylko 1z
def project_state_to_atoms(psi_state):

    density_r = simpson(
        np.abs(psi_state)**2,
        theta,
        axis=1
    )

    atom_density = []

    for x, y, z in coords:

        rr = np.sqrt(
            (x - x0)**2 +
            (y - y0)**2
        )

        rho = np.interp(
            rr,
            r,
            density_r,
            left=0,
            right=0
        )

        atom_density.append(rho)

    return np.array(atom_density)

